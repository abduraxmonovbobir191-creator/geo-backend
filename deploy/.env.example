# install.sh copies this to .env and fills in the secrets. Edit before the first start.

# Your domain. DNS A records needed: nexecos.com, api., tiles. and map. -> this server's IP.
DOMAIN=nexecos.com

# Where databases and map files live. Put it on the big disk if you mounted one, e.g. /mnt/storage/nexmap.
DATA_DIR=/srv/nexmap
# Rendered tile cache; it can grow large, so it can also go on the big disk.
TILE_CACHE_DIR=/srv/nexmap/tile-cache
TILE_CACHE_SIZE=100g
# Daily database backups (backup.sh).
BACKUP_DIR=/srv/nexmap/backups

# Filled in by install.sh with random values. Never share them.
POSTGRES_PASSWORD=
JWT_SECRET=
NOMINATIM_PASSWORD=

# Address search data. Uzbekistan by default; other Geofabrik regions work the same way,
# e.g. https://download.geofabrik.de/asia-latest.osm.pbf (much bigger and slower to import).
NOMINATIM_PBF_URL=https://download.geofabrik.de/asia/uzbekistan-latest.osm.pbf
NOMINATIM_REPLICATION_URL=https://download.geofabrik.de/asia/uzbekistan-updates/
NOMINATIM_THREADS=6
