# Copy to .env and adjust.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexmap

# Required in production. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=30d

# Comma-separated list of allowed web origins, or * for any.
CORS_ORIGIN=*

# Nominatim-compatible geocoder for address search. The public OpenStreetMap server allows
# about 1 request per second; run your own for heavy use.
GEOCODER_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=NexMap/0.1 (contact@example.com)

# Rate limits per window (milliseconds).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_API_KEY_MAX=120
RATE_LIMIT_DEFAULT_MAX=600
RATE_LIMIT_AUTH_MAX=30

# Nex ID: the only sign-in of the Nex ecosystem (same account as Nexly, Nexgram, Nex AI).
# Register this client at Nex ID with the redirect nexmap://auth. The secret stays on the server.
NEXID_ISSUER=https://id.nexecos.com
NEXID_CLIENT_ID=
NEXID_CLIENT_SECRET=
NEXID_REDIRECT_URIS=nexmap://auth
NEXID_POST_LOGOUT_URI=nexmap://logout
PLAN_CACHE_MINUTES=30
# Old e-mail + password accounts (off in production by default).
LEGACY_PASSWORD_LOGIN=0
# Other Nex products call /internal/v1 with X-Service-Key. name:key, comma separated. Never expose /internal publicly.
SERVICE_KEYS=
